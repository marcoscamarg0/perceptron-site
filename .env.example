# ──────────────────────────────────────────────────────────────
# Variáveis de ambiente — Perceptron Consultoria
# Copie este arquivo para .env e preencha os valores reais
# ──────────────────────────────────────────────────────────────

# ── E-mail de contato ─────────────────────────────────────────
# Endereço que RECEBE as mensagens do formulário de contato
CONTACT_EMAIL=contato@perceptronconsult.com

# Credenciais da conta que ENVIA os e-mails (conta SMTP)
# Opção 1 — Gmail com App Password (recomendado)
#   1. Ative a verificação em 2 etapas na conta Google
#   2. Acesse: myaccount.google.com → Segurança → Senhas de app
#   3. Crie uma senha para "Mail" e cole abaixo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Opção 2 — Outro provedor SMTP (ex: Hostinger, Locaweb, SendGrid)
# EMAIL_HOST=smtp.seudominio.com.br
# EMAIL_PORT=587
# EMAIL_USER=contato@perceptronconsult.com
# EMAIL_PASS=sua-senha-aqui

# ── MongoDB (opcional) ────────────────────────────────────────
# Deixe em branco para usar armazenamento em memória (dados reiniciam com o servidor)
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/perceptron
