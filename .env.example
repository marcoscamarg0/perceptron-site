# ──────────────────────────────────────────────────────────────
# Variáveis de ambiente — Perceptron Consultoria
# Copie este arquivo para .env e preencha os valores reais
# NUNCA versione o arquivo .env (já está no .gitignore)
# ──────────────────────────────────────────────────────────────

# ── Painel Admin ──────────────────────────────────────
# OBRIGATÓRIO: senha do painel de administração.
# A senha antiga (admin_perceptron) está pública no README — troque agora!
# Escolha uma senha forte com letras, números e símbolos.
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_AQUI

# ── E-mail de contato ─────────────────────────────────
# Endereço que RECEBE as mensagens do formulário de contato
CONTACT_EMAIL=contato@perceptronconsult.com

# Credenciais da conta que ENVIA os e-mails (conta SMTP)
# Opção 1 — Gmail com App Password (recomendado)
#   1. Ative a verificação em 2 etapas na conta Google
#   2. Acesse: myaccount.google.com → Segurança → Senhas de app
#   3. Crie uma senha para "Mail" e cole abaixo (formato: xxxx xxxx xxxx xxxx)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Opção 2 — Outro provedor SMTP (ex: Hostinger, Locaweb, SendGrid)
# EMAIL_HOST=smtp.seudominio.com.br
# EMAIL_PORT=587
# EMAIL_USER=contato@perceptronconsult.com
# EMAIL_PASS=sua-senha-aqui

# ── WhatsApp via CallMeBot (opcional, GRATUITO) ───────
# Como ativar (1 vez só, por WhatsApp):
#   1. Adicione +34 644 65 72 88 nos seus contatos
#   2. Mande a mensagem: "I allow callmebot to send me messages"
#   3. Você receberá de volta seu API KEY
#   4. Coloque seu número com DDI (ex: 5561981802825) e a chave abaixo
CALLMEBOT_PHONE=5561981802825
CALLMEBOT_APIKEY=000000

# ── MongoDB (persistência real — recomendado) ─────────
# Sem esta variável, dados ficam na memória e se perdem ao reiniciar o servidor.
# Para configurar: veja MONGODB_SETUP.md
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/perceptron
